<Window
    x:Class="WuwaAssetExplorer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <TextBlock Margin="48,0,0,0"
                       VerticalAlignment="Center"
                       Text="WuwaAssetExplorer"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <NavigationView x:Name="RootNavigation"
                        Grid.Row="1"
                        PaneDisplayMode="LeftCompact"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="RootNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="资源" Tag="Assets">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="引用关系" Tag="References">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid x:Name="AssetsView" Padding="20,16,20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <InfoBar x:Name="LoadInfoBar"
                             Grid.Row="0"
                             Margin="0,0,0,12"
                             IsOpen="False"
                             IsClosable="True" />

                    <Grid Grid.Row="1" Margin="0,0,0,12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Click="ChooseGameDirectory_Click" Content="选择游戏目录" />
                        <Button Grid.Column="1" Click="LoadGame_Click" Content="加载" />
                        <AutoSuggestBox x:Name="AssetSearchBox"
                                        Grid.Column="2"
                                        MinWidth="320"
                                        PlaceholderText="搜索资源名称或路径"
                                        TextChanged="AssetSearchBox_TextChanged">
                            <AutoSuggestBox.QueryIcon>
                                <SymbolIcon Symbol="Find" />
                            </AutoSuggestBox.QueryIcon>
                        </AutoSuggestBox>
                        <ProgressRing x:Name="BusyRing"
                                      Grid.Column="3"
                                      Width="20"
                                      Height="20"
                                      IsActive="False" />
                    </Grid>

                    <Grid Grid.Row="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Padding="0,4,8,4"
                                BorderThickness="0,0,1,0"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <TreeView x:Name="DirectoryTree"
                                      SelectionMode="Single"
                                      Expanding="DirectoryTree_Expanding"
                                      ItemInvoked="DirectoryTree_ItemInvoked"
                                      DoubleTapped="DirectoryTree_DoubleTapped" />
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <BreadcrumbBar x:Name="DirectoryBreadcrumb"
                                           Margin="0,0,0,6"
                                           ItemClicked="DirectoryBreadcrumb_ItemClicked" />

                            <ListView x:Name="BrowserList"
                                      Grid.Row="1"
                                      SelectionMode="Single"
                                      DoubleTapped="BrowserList_DoubleTapped">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="6,7" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Detail}"
                                                       Opacity="0.78"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.ColumnSpan="2"
                                                       Margin="0,2,0,0"
                                                       Opacity="0.68"
                                                       Text="{Binding FullPath}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,10,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AssetCountText" Text="未加载游戏" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="SearchCountText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" />
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <ProgressBar x:Name="LoadProgressBar"
                                         Width="140"
                                         Minimum="0"
                                         Maximum="100"
                                         Visibility="Collapsed" />
                            <TextBlock x:Name="StatusText"
                                       VerticalAlignment="Center"
                                       Text="就绪"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="ReferencesView" Padding="20,16,20,16" Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="引用关系" Style="{StaticResource TitleTextBlockStyle}" />
                        <InfoBar IsOpen="True"
                                 IsClosable="False"
                                 Severity="Informational"
                                 Title="下一阶段功能"
                                 Message="资源浏览目录验证后，将在这里加入持久化正向/反向引用索引、递归引用树与两项资源之间的路径查询。" />
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed">
                    <StackPanel Padding="20,16,20,24" Spacing="16" MaxWidth="860" HorizontalAlignment="Left">
                        <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="鸣潮 Paks 目录" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBox x:Name="PaksPathTextBox" PlaceholderText="…\Wuthering Waves Game\Client\Content\Paks" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="AES Endpoint" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBox x:Name="AesEndpointTextBox" />
                            <TextBlock Text="默认使用维护中的鸣潮 keys.json Endpoint；网络不可用时会尝试读取程序目录 Data 中的最近缓存。"
                                       TextWrapping="Wrap"
                                       Opacity="0.72"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="RefreshAes_Click" Content="刷新并测试 AES" />
                            <Button Click="SaveSettings_Click" Content="保存设置" />
                        </StackPanel>

                        <InfoBar x:Name="SettingsInfoBar" IsOpen="False" IsClosable="True" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
